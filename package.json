{
  "name": "adhyay-pdf-reader",
  "version": "1.0.0",
  "description": "Adhyay PDF Reader Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.adhyay.pdfreader",
    "productName": "Adhyay PDF Reader",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "src/**"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VINAY-MANDAL/Adhyay_code_base.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/VINAY-MANDAL/Adhyay_code_base/issues"
  },
  "homepage": "https://github.com/VINAY-MANDAL/Adhyay_code_base#readme",
  "allowScripts": {
    "electron": true
  }
}



